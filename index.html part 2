        <!-- ================= PROGRAMMES ================= -->

        <section id="programmes" class="programmes-section">

            <div class="container">

                <div class="section-heading">

                    <span class="section-label">
                        WHAT WE OFFER
                    </span>

                    <h2>
                        Our Programmes
                    </h2>

                    <p>
                        Our programmes are designed to help learners
                        understand their schoolwork, improve their
                        academic performance and develop confidence.
                    </p>

                </div>


                <div class="programme-grid">

                    <article class="programme-card">

                        <img
                            src="images/tutoring.jpg"
                            alt="Primary school tutoring"
                            loading="lazy">

                        <div class="programme-content">

                            <span class="programme-number">
                                01
                            </span>

                            <h3>
                                Primary School Support
                            </h3>

                            <p>
                                Academic support for Grades 4–7
                                learners, including homework assistance,
                                revision and subject support.
                            </p>

                            <ul>
                                <li>Homework assistance</li>
                                <li>Reading support</li>
                                <li>Mathematics support</li>
                                <li>Exam preparation</li>
                            </ul>

                        </div>

                    </article>


                    <article class="programme-card">

                        <img
                            src="images/books.jpg"
                            alt="Books and study resources"
                            loading="lazy">

                        <div class="programme-content">

                            <span class="programme-number">
                                02
                            </span>

                            <h3>
                                High School Tutoring
                            </h3>

                            <p>
                                Focused academic support for Grades
                                8–12 learners preparing for tests and
                                examinations.
                            </p>

                            <ul>
                                <li>Subject revision</li>
                                <li>Homework support</li>
                                <li>Exam preparation</li>
                                <li>Study planning</li>
                            </ul>

                        </div>

                    </article>


                    <article class="programme-card">

                        <div class="programme-icon">
                            📝
                        </div>

                        <div class="programme-content">

                            <span class="programme-number">
