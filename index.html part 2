        <!-- ================= ABOUT ================= -->

        <section id="about" class="about-section">

            <div class="container about-grid">

                <div class="about-image">

                    <picture>

                        <img
                            src="images/community.jpg"
                            srcset="
                                images/community.jpg 600w,
                                images/community.jpg 1000w,
                                images/community.jpg 1400w"
                            sizes="
                                (max-width: 600px) 100vw,
                                (max-width: 1024px) 50vw,
                                50vw"
                            alt="Community education programme"
                            loading="lazy">

                    </picture>

                </div>


                <div class="about-content">

                    <span class="section-label">
                        ABOUT US
                    </span>

                    <h2>
                        Supporting Learners Since 2022
                    </h2>

                    <p>
                        Bright Beginnings Learning Foundation was
                        founded in 2022 by a small group of local
                        teachers and community volunteers in
                        Lebowakgomo.
                    </p>

                    <p>
                        The foundation was created because of concerns
                        about learners falling behind due to
                        overcrowded classrooms, limited academic
                        support at home and a shortage of educational
                        resources.
                    </p>

                    <p>
                        What started as informal after-school study
                        sessions in a community hall has grown into
                        a structured tutoring programme supporting
                        learners across the community.
                    </p>

                    <div class="mission-box">

                        <h3>
                            Our Mission
                        </h3>

                        <p>
                            To provide free, accessible and consistent
                            after-school tutoring and homework support
                            in a safe and supportive environment.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- ================= MISSION / VISION ================= -->

        <section class="mission-section">

            <div class="container">

